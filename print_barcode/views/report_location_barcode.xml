<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

<template id="report_location_barcode">
    <t t-call="report.html_container">
        <div class="page">
            <table>
                <tr t-foreach="[docs[x:x+3] for x in xrange(0, len(docs), 3)]" t-as="range_docs">
                    <td t-foreach="range_docs" t-as="location">
                        <div class="text-center" style="margin: 20px;">
                            <span t-field="location.name"/><br/>
                            <t t-if="location.barcode"><t t-set="content" t-value="location.barcode"/></t>
                            <t t-if="not location.barcode"><t t-set="content" t-value="location.name"/></t>
                            <img class="barcode" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;humanreadable=1' % ('Code128', content, 600, 100)" style="width:300px;height:50px"/>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </t>
</template>

<template id="report_product_barcode">
    <t t-call="report.html_container">
        <div class="page">
            <table>
                <tr t-foreach="[docs[x:x+3] for x in xrange(0, len(docs), 3)]" t-as="range_docs">
                    <td t-foreach="range_docs" t-as="product">
                        <div class="text-center" style="margin: 20px;">
                            <span t-field="product.name"/><br/>
                            <t t-if="product.barcode"><t t-set="content" t-value="product.barcode"/></t>
                            <t t-if="not product.barcode"><t t-set="content" t-value="product.name"/></t>
                            <img class="barcode" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;humanreadable=1' % ('Code128', content, 600, 100)" style="width:300px;height:50px"/>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </t>
</template>

<report id="stock.action_report_location_barcode" model="stock.location" report_type="qweb-pdf" name="print_barcode.report_location_barcode" string="Location BarCode" file="print_barcode.report_location_barcode"/>
<report id="action_report_product_barcode" model="product.template" report_type="qweb-pdf" name="print_barcode.report_product_barcode" string="Product BarCode" file="print_barcode.report_product_barcode"/>

</odoo>