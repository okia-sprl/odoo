<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="print_barcode_view_form" model="ir.ui.view">
        <field name="name">print.barcode.view.form</field>
        <field name="model">print.barcode</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="is_group_by_category"/>
                    </group>
                    <group>
                        <field name="nbr_columns"/>
                        <field name="barcode_width"/>
                        <field name="barcode_height"/>
                        <field name="order_by"/>
                        <field name="product_category_id"/>
                        <field name="nbr_products"/>
                    </group>
                    <footer>
                        <button name="print_barcode" string="_Print" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print_barcode" model="ir.actions.act_window">
        <field name="name">Print BarCode</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">print.barcode</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <act_window
            id="action_print_product_product_barcode"
            name="Print BarCode"
            res_model="print.barcode"
            src_model="product.product"
            view_mode="form"
            multi="True"
            target="new"
            key2="client_action_multi"
        />

    <act_window
            id="action_print_product_template_barcode"
            name="Print BarCode"
            res_model="print.barcode"
            src_model="product.template"
            view_mode="form"
            multi="True"
            target="new"
            key2="client_action_multi"
        />

    <menuitem id="print_barcode_menu" name="Print BarCode" sequence="999" action="action_print_barcode" parent="stock.menu_warehouse_report"/>
</odoo>