<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="inventory_transfer_comp_rule" model="ir.rule">
        <field name="name">Inventory Transfer multi-company</field>
        <field name="model_id" ref="model_inventory_transfer"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>
    </record>

    <record id="inventory_transfer_line_comp_rule" model="ir.rule">
        <field name="name">Inventory Transfer Line multi-company</field>
        <field name="model_id" ref="model_inventory_transfer_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>
    </record>
</odoo>