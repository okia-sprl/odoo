<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="inventory_transfer_view_form" model="ir.ui.view">
        <field name="name">inventory.transfer.view.form</field>
        <field name="model">inventory.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="validate_transfer" string="Validate Transfer" class="oe_highlight" states="draft" confirm="Are you sure that you want to validate this transfer ?" type="object"/>
                </header>
                <sheet>
                    <field name="state" invisible="1"/>
                    <group>
                        <group>
                            <field name="name" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="company_id" attrs="{'readonly': [('state', '!=', 'draft')]}" options="{'no_create': 1, 'no_open': 1}"/>
                            <field name="dest_company_id" attrs="{'readonly': [('state', '!=', 'draft')]}" domain="[('id', '!=', company_id)]" options="{'no_create': 1, 'no_open': 1}"/>
                        </group>
                        <group>
                            <field name="production_location_id" attrs="{'readonly': [('state', '!=', 'draft')]}" options="{'no_create': 1, 'no_open': 1}"/>
                            <field name="location_id" attrs="{'readonly': [('state', '!=', 'draft')]}" options="{'no_create': 1, 'no_open': 1}"/>
                        </group>
                    </group>
                    <group string="Lines">
                        <field name="transfer_line_ids" nolabel="1" attrs="{'readonly': [('state', '!=', 'draft')]}" context="{'default_production_location_id': production_location_id}">
                            <tree editable="bottom">
                                <field name="product_id" options="{'no_create': 1, 'no_open': 1}"/>
                                <field name="product_uom_id" options="{'no_create': 1, 'no_open': 1}"  domain="[('id', 'in', allowed_uom_ids and allowed_uom_ids[0][2] or [])]"/>
                                <field name="product_qty"/>
                                <field name="production_location_id" options="{'no_create': 1, 'no_open': 1}"/>
                                <field name="allowed_uom_ids" invisible="1"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="inventory_transfer_view_tree" model="ir.ui.view">
        <field name="name">inventory.transfer.view.tree</field>
        <field name="model">inventory.transfer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
            </tree>
        </field>
    </record>

    <record id="action_inventory_transfer" model="ir.actions.act_window">
        <field name="name">Inventory Transfer</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">inventory.transfer</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="main_menu_inventory_transfer" name="Inventory Transfer" sequence="5" parent="stock.menu_stock_root"/>
    <menuitem id="menu_inventory_transfer" name="Inventory Transfer" sequence="1" action="action_inventory_transfer" parent="main_menu_inventory_transfer"/>
</odoo>