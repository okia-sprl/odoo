<odoo noupdate="1">
    <record id="paperformat_picking_report" model="report.paperformat">
        <field name="name">Picking report</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">96</field>
        <field name="report_ids" eval="[(4, ref('action_stock_picking_report')), (4, ref('action_stock_picking_daily_report')), (4, ref('action_stock_picking_all_report'))]"/>
    </record>
</odoo>