<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_assets_common" name="report_assets_common" inherit_id="web.report_assets_common">
            <xpath expr="." position="inside">
                <link rel="stylesheet" href="/stock_picking_report/static/src/css/picking_report.css"/>
            </xpath>
        </template>

        <template id="stock_picking_report_body">
            <t t-set="days" t-value="docs.get_days()"/>
            <t t-set="product_locations_values" t-value="docs.get_lines()"/>

            <h1>Picking report from <t t-esc="days[0]"/> to <t t-esc="days[-1]"/></h1>

            <table class="stock_picking_report">
                <thead>
                    <tr>
                        <th/>
                        <th t-foreach="days" t-as="day">
                            <span t-esc="day"/>
                        </th>
                        <th>Comment</th>
                    </tr>
                </thead>

                <t t-foreach="product_locations_values" t-as="product_location_values">
                    <t t-set="product_location" t-value="product_location_values[0]"/>
                    <t t-set="product_location_lines" t-value="product_location_values[1]"/>

                    <tr>
                        <td colspan="9"><h3><span t-if="product_location" t-esc="product_location.name"/><t t-else="">No Location</t></h3></td>
                    </tr>
                    <tr t-foreach="product_location_lines" t-as="product_location_line">

                        <td>
                            <span t-field="product_location_line[0].name"/>
                            <t t-if="product_location_line[0].product_action_ids"> (<strong><t t-esc="', '.join(product_location_line[0].product_action_ids.mapped('name'))" /></strong>)</t>
                        </td>
                        <td t-foreach="days" t-as="day">
                            <t t-if="day in product_location_line[1]">
                                <span t-esc="product_location_line[1][day][0]"/> <strong>x</strong>
                                <span t-esc="product_location_line[1][day][1]"/>
                            </t>
                        </td>
                        <td class="stock_picking_report_comment"/>
                    </tr>
                </t>
            </table>
        </template>

        <template id="stock_picking_report">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-call="stock_picking_report.stock_picking_report_body"/>
                    </div>
                </t>
            </t>
        </template>

        <record id="action_stock_picking_report" model="ir.actions.report">
            <field name="name">Picking Report</field>
            <field name="model">stock.picking.report.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">stock_picking_report.stock_picking_report</field>
            <field name="report_file">stock_picking_report.stock_picking_report</field>
        </record>
    </data>
</odoo>
