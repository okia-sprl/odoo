<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="stock_picking_all_report">
            <t t-call="web.html_container">
                <t t-call="report.external_layout">
                    <div class="page">
                        <div style="page-break-after: always;">
                            <t t-call="stock_picking_report.stock_picking_daily_report_body"/>
                        </div>
                        <div>
                            <t t-call="stock_picking_report.stock_picking_report_body"/>
                        </div>
                    </div>
                </t>
            </t>
        </template>

        <report
                string="Picking All Report"
                id="action_stock_picking_all_report"
                model="stock.picking.report.wizard"
                report_type="qweb-pdf"
                name="stock_picking_report.stock_picking_all_report"
                file="stock_picking_all_report"
        />

    </data>
</odoo>
