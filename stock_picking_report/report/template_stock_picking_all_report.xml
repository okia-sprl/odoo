<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="stock_picking_all_report">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div style="page-break-after: always;">
                            <t t-call="stock_picking_report.stock_picking_daily_report_body"/>
                        </div>
                        <div>
                            <t t-call="stock_picking_report.stock_picking_report_body"/>
                        </div>
                    </div>
                </t>
            </t>
        </template>

        <record id="action_stock_picking_all_report" model="ir.actions.report">
            <field name="name">Picking All Report</field>
            <field name="model">stock.picking.report.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">stock_picking_report.stock_picking_all_report</field>
            <field name="report_file">stock_picking_report.stock_picking_all_report</field>
        </record>
    </data>
</odoo>
