<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="stock_picking_daily_report_body">
            <t t-set="partners" t-value="docs.get_partners()"/>
            <t t-set="lines" t-value="docs.get_daily_lines()"/>

            <table class="stock_picking_report">
                <tr>
                    <th/>
                    <th t-foreach="partners" t-as="partner">
                        <span t-esc="partner"/>
                    </th>
                    <th>Barcode</th>
                </tr>

                <tr t-foreach="lines" t-as="product">
                    <td><span t-esc="product.name"/></td>
                    <td t-foreach="partners" t-as="partner">
                        <t t-if="partner in lines[product]">
                            <span t-esc="lines[product][partner][0]"/> <strong>x</strong>
                            <span t-esc="lines[product][partner][1]"/>
                            (<span t-esc="lines[product][partner][2]"/>)
                        </t>
                    </td>
                    <td>
                        <img class="barcode" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;humanreadable=1' % ('Code128', product.barcode, 200, 50)"/>
                    </td>
                </tr>
            </table>
        </template>

        <template id="stock_picking_daily_report">
            <t t-call="report.html_container">
                <t t-call="report.external_layout">
                    <div class="page">
                        <t t-call="stock_picking_report.stock_picking_daily_report_body"/>
                    </div>
                </t>
            </t>
        </template>

        <report
                string="Picking Daily Report"
                id="action_stock_picking_daily_report"
                model="stock.picking.report.wizard"
                report_type="qweb-pdf"
                name="stock_picking_report.stock_picking_daily_report"
                file="stock_picking_daily_report"
        />

    </data>
</odoo>
