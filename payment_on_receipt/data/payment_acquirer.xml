<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_acquirer_on_receipt" model="payment.acquirer">
        <field name="name">On Receipt</field>
        <field name="provider">on_receipt</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="view_template_id" ref="payment.default_acquirer_button"/>
        <field name="auto_confirm">none</field>
        <field name="image" type="base64" file="payment_on_receipt/static/src/img/on_receipt_icon.png"/>
        <field name="environment">test</field>
        <field name="website_published" eval="True"/>
        <field name="pre_msg">Pay on receipt.</field>
        <field name="pending_msg">&lt;i&gt;The order is validated&lt;/i&gt;...</field>
        <field name="post_msg">Please come to the shop to retrieve your order.</field>
        <field name="description" type="html">
            <p>
                Provide instructions to customers so that they can pay directly at your shop.
            </p>
            <ul>
                <li><i class="fa fa-check"/>eCommerce</li>
            </ul>
        </field>
    </record>
</odoo>
