#. module: payment_on_receipt
#: model:payment.acquirer,cancel_msg:payment_on_receipt.payment_acquirer_on_receipt
msgid "<span><i>Cancel,</i> Your payment has been cancelled.</span>"
msgstr "<span><i>Annuler,</i> votre paiement a été annulé.</span>"

#. module: payment_on_receipt
#: model:payment.acquirer,done_msg:payment_on_receipt.payment_acquirer_on_receipt
msgid "<span><i>Done,</i> Your online payment has been successfully processed. Thank you for your order.</span>"
msgstr "<span><i>Terminé,</i> votre paiement en ligne a été enregistré. Merci de votre commande.</span>"

#. module: payment_on_receipt
#: model:payment.acquirer,error_msg:payment_on_receipt.payment_acquirer_on_receipt
msgid "<span><i>Error,</i> Please be aware that an error occurred during the transaction. The order has been confirmed but will not be paid. Do not hesitate to contact us if you have any questions on the status of your order.</span>"
msgstr "<span><i>Erreur,</i> une erreur est survenue lors de la transaction. La commande a été confirmée mais ne sera pas réglée. N'hésitez pas à nous contacter pour toute question sur le statut de la commande.</span>"

#. module: payment_on_receipt
#: model:payment.acquirer,pending_msg:payment_on_receipt.payment_acquirer_on_receipt
msgid "<span><i>The order is validated</i>...</span>"
msgstr "<span><i>La commande a été validée</i>...</span>"

#. module: payment_on_receipt
#: model:payment.acquirer,name:payment_on_receipt.payment_acquirer_on_receipt
msgid "On Receipt"
msgstr "A la réception"

#. module: payment_on_receipt
#: model:payment.acquirer,pre_msg:payment_on_receipt.payment_acquirer_on_receipt
msgid "Pay on receipt."
msgstr "Paiement à la réception."

#. module: payment_on_receipt
#: model:ir.model,name:payment_on_receipt.model_payment_acquirer
msgid "Payment Acquirer"
msgstr "Intermédiaire de Paiement"

#. module: payment_on_receipt
#: model:ir.model,name:payment_on_receipt.model_payment_transaction
msgid "Payment Transaction"
msgstr "Transaction"

#. module: payment_on_receipt
#: model:payment.acquirer,post_msg:payment_on_receipt.payment_acquirer_on_receipt
msgid "Please come to the shop to retrieve your order."
msgstr "Veuillez vous rendre au magasin pour récupérer votre commande."

