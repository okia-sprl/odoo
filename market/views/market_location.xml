<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="market_location_view_tree" model="ir.ui.view">
        <field name="name">market.location.view.tree</field>
        <field name="model">market.location</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="address"/>
                <field name="notes"/>
            </tree>
        </field>
    </record>

    <record id="market_location_action" model="ir.actions.act_window">
        <field name="name">Market location</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">market.location</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="market_menu_location" name="Location" sequence="50" action="market_location_action" parent="sub_menu_market_configuration"/>
</odoo>