<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="market_product_list_view_form" model="ir.ui.view">
        <field name="name">market.product.list.view.form</field>
        <field name="model">market.product.list</field>
        <field name="arch" type="xml">
            <form string="Product list">
                <group>
                    <field name="name" />
                    <field name="sequence"/>
                    <field name="is_active"/>
                </group>
                <seperator for="product_ids" string="Products"/>
                <field name="product_ids"/>
            </form>
        </field>
    </record>

    <record id="market_product_list_view_tree" model="ir.ui.view">
        <field name="name">market.product.list.view.tree</field>
        <field name="model">market.product.list</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <record id="market_product_list_action" model="ir.actions.act_window">
        <field name="name">Product list</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">market.product.list</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_market_product_list" name="Product list" parent="main_menu_market_configuration"
            sequence="5" action="market_product_list_action" />
</odoo>