<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_plu_view_form" model="ir.ui.view">
        <field name="name">product.plu.view.form</field>
        <field name="model">product.plu</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="product_id"/>
                                <field name="is_to_invoice"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_plu_view_tree" model="ir.ui.view">
        <field name="name">product.plu.view.tree</field>
        <field name="model">product.plu</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_product_plu" model="ir.actions.act_window">
        <field name="name">Product PLU</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.plu</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="product_plu_menu" name="Product PLU" sequence="40" action="action_product_plu" parent="market.main_menu_market_configuration"/>
</odoo>