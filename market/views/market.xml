<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="market_order_view_tree" model="ir.ui.view">
        <field name="name">market.order.view.tree</field>
        <field name="model">market.order</field>
        <field name="arch" type="xml">
            <tree decoration-bf="message_unread==True" decoration-muted="state=='cancel'" decoration-info="state in ('wait','confirmed')" string="Market Order">
                <field name="message_unread" invisible="1"/>
                <field name="name" string="Reference"/>
                <field name="date_order" />
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="market_order_view_form" model="ir.ui.view">
        <field name="name">market.order.view.form</field>
        <field name="model">market.order</field>
        <field name="arch" type="xml">
            <form string="Market order">
                <header>
                    <button name="print_market_order" string="Print" type="object" states="draft" class="oe_highlight" groups="base.group_user"/>
                    <button name="print_market_order" string="Print" type="object" states="sent" groups="base.group_user"/>
                    <button name="button_confirm" type="object" states="draft" string="Confirm Order" id="draft_confirm" class="oe_highlight"/>
                    <button name="button_approve" type="object" states='to approve' string="Approve Order" class="oe_highlight" groups="purchase.group_purchase_manager"/>
                    <button name="action_view_picking" string="Receive Products" class="oe_highlight" type="object" attrs="{'invisible': ['|', '|' , ('is_shipped', '=', True), ('state','not in', ('purchase','done')), ('picking_count', '=', 0)]}"/>
                    <button name="button_draft" states="cancel" string="Set to Draft" type="object" />
                    <button name="button_cancel" states="draft,to approve,sent,purchase" string="Cancel" type="object" />
                    <button name="button_done" type="object" string="Lock" states="purchase"/>
                    <button name="button_unlock" type="object" string="Unlock" states="done" groups="purchase.group_purchase_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,purchase" readonly="1"/>
                </header>
                <sheet>
                    <field name="picking_count" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="market_name"/>
                        </h1>
                        <h2>
                            <field name="name" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="True" string="Supplier"/>
                            <field name="market_product_list_id" attrs="{'readonly': [('state', 'in', ('purchase', 'done', 'cancel'))]}"/>
                            <field name="currency_id" groups="base.group_multi_currency" readonly="True"/>
                            <field name="is_shipped" invisible="1"/>

                        </group>
                        <group>
                            <field name="date_order" attrs="{'readonly': [('state', 'in', ('purchase', 'done', 'cancel'))]}"/>
                            <field name="date_planned" invisible="1"/>
                            <field name="stored_date_planned" attrs="{'readonly': [('state', 'in', ('purchase', 'done', 'cancel'))]}"/>
                            <field name="origin" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="order_line" attrs="{'readonly': [('state', 'in', ('done', 'cancel'))]}">
                                 <tree string="Purchase Order Lines" editable="bottom">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="state" invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" attrs="{'readonly': [('state', 'in', ('purchase', 'to approve','done', 'cancel'))]}" context="{'partner_id':parent.partner_id, 'quantity':product_qty,'uom':product_uom, 'company_id': parent.company_id}"/>
                                    <field name="name"/>
                                    <field name="date_planned" invisible="1"/>
                                    <field name="company_id" invisible="1"/>
                                    <field name="account_analytic_id" invisible="1"/>
                                    <field name="analytic_tag_ids" invisible="1"/>
                                    <field name="qty_available" readonly="1"/>
                                    <field name="virtual_available" readonly="1"/>
                                    <field name="product_qty"/>
                                    <field name="qty_received" invisible="1"/>
                                    <field name="qty_invoiced" invisible="1"/>
                                    <field name="product_uom" groups="product.group_uom" attrs="{'readonly': [('state', 'in', ('purchase', 'done', 'cancel'))]}"/>
                                    <field name="price_unit" invisible="1"/>
                                    <field name="taxes_id" invisible="1"/>
                                    <field name="price_subtotal" invisible="1"/>
                                </tree>
                                <form string="Purchase Order Line">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="product_id"
                                                       context="{'partner_id': parent.partner_id}"/>
                                                <label for="product_qty"/>
                                                <div>
                                                    <field name="product_qty" class="oe_inline"/>
                                                    <span class="oe_inline">&#160;</span>
                                                    <field name="product_uom" groups="product.group_uom" class="oe_inline"/>
                                                </div>
                                                <field name="price_unit"/>
                                            </group>
                                            <group>
                                                <field name="taxes_id" widget="many2many_tags" domain="[('type_tax_use', '=', 'purchase')]"/>
                                                <field name="date_planned" widget="date"/>
                                                <field name="account_analytic_id" colspan="2" groups="purchase.group_analytic_accounting"/>
                                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                                            </group>
                                        </group>
                                        <notebook>
                                        <page string="Notes">
                                            <field name="name"/>
                                        </page><page string="Invoices and Incoming Shipments">
                                            <field name="invoice_lines"/>
                                            <field name="move_ids"/>
                                        </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                            <group class="oe_subtotal_footer oe_right" invisible="True">
                                <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <div class="oe_subtotal_footer_separator oe_inline">
                                    <label for="amount_total"/>
                                </div>
                                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                            <field name="notes" class="oe_inline" placeholder="You can add here some information about the market"/>
                            <div class="oe_clear"/>
                        </page>
                        <page string="Deliveries &amp; Invoices" invisible="True">
                            <group>
                                <group>
                                    <field name="picking_type_id" domain="[('code','=','incoming')]" options="{'no_create': True}" groups="stock.group_stock_multi_locations"/>
                                    <field name="dest_address_id" groups="stock.group_stock_multi_locations" attrs="{'invisible': [('default_location_dest_id_usage', '!=', 'customer')], 'required': [('default_location_dest_id_usage', '=', 'customer')]}"/>
                                    <field name="default_location_dest_id_usage" invisible="1"/>
                                    <field name="incoterm_id"/>
                                </group>
                                <group>
                                    <field name="invoice_status"/>
                                    <field name="payment_term_id" options="{'no_open': True, 'no_create': True}" attrs="{'readonly': ['|', ('invoice_status','=', 'invoiced'), ('state', '=', 'done')]}"/>
                                    <field name="fiscal_position_id" attrs="{'readonly': ['|', ('invoice_status','=', 'invoiced'), ('state', '=', 'done')]}"/>
                                    <field name="date_approve" groups="base.group_no_one"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
                </form>
        </field>
    </record>

    <record id="market_order_action" model="ir.actions.act_window">
        <field name="name">Market</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">market.order</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="market_order_action_view_tree" model="ir.actions.act_window.view">
        <field eval="1" name="sequence"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="market_order_view_tree"/>
        <field name="act_window_id" ref="market_order_action"/>
    </record>
    <record id="market_order_action_view_form" model="ir.actions.act_window.view">
        <field eval="2" name="sequence"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="market_order_view_form"/>
        <field name="act_window_id" ref="market_order_action"/>
    </record>

    <menuitem id="market_menu_root" name="Markets" sequence="80" web_icon="market,static/description/icon.png" groups="market_order_group_user"/>
    <menuitem id="main_market_menu" name="Market" sequence="1" parent="market_menu_root"/>
    <menuitem id="market_menu" name="Market" sequence="1" action="market_order_action" parent="main_market_menu"/>
</odoo>