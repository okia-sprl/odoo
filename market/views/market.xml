<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="market_market_view_list" model="ir.ui.view">
        <field name="name">market.market.view.list</field>
        <field name="model">market.market</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="location_id"/>
                <field name="description"/>
                <field name="market_date"/>
                <field name="market_amount_taxed"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="market_view_form" model="ir.ui.view">
        <field name="name">market.view.form</field>
        <field name="model">market.market</field>
        <field name="arch" type="xml">
            <form string="Market">
                <header>
                    <button name="action_confirm" invisible="state != 'draft'" string="Confirm" type="object" class="oe_highlight"/>
                    <button name="action_cancel" invisible="state != 'draft'" string="Cancel" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"></div>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description" readonly="state != 'draft'"/>
                            <field name="market_date" readonly="state != 'draft'"/>
                            <field name="location_id"/>
                            <field name="stock_picking_id" invisible="state != 'confirm'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <label for="notes"/>
                    <field name="notes" readonly="state != 'draft'"/>
                    <notebook>
                        <page string="Market summary" name="market_summary">
                            <field name="market_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="plu"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="market_unit_price_untaxed"/>
                                    <field name="market_unit_price_taxed"/>
                                    <field name="market_amount_taxed"/>
                                    <field name="qty_available"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="market_action" model="ir.actions.act_window">
        <field name="name">Market</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">market.market</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="market_menu" name="Market" sequence="1" action="market_action" parent="main_market_menu"/>
</odoo>
