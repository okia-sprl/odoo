<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="market_market_view_tree" model="ir.ui.view">
        <field name="name">market.market.view.tree</field>
        <field name="model">market.market</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="market_date"/>
                <field name="market_amount_taxed"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="market_view_form" model="ir.ui.view">
        <field name="name">market.view.form</field>
        <field name="model">market.market</field>
        <field name="arch" type="xml">
            <form string="Market">
                <header>
                    <button name="action_confirm" states="draft" string="Confirm" type="object" class="oe_highlight"/>
                    <button name="action_cancel" states="draft" string="Cancel" type="object"/>
                    <field name="state" widget="statusbar" readonly="1" statusbar_visible="draft,confirm"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description" required="True"/>
                            <field name="market_date" required="True"/>
                            <field name="market_location_id"/>
                        </group>
                        <group>
                            <field name="purchase_order_id"/>
                            <field name="sale_order_id"/>
                        </group>
                    </group>
                    <label for="market_line_ids"/>
                    <field name="market_line_ids">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="product_uom_id"/>
                            <field name="is_to_invoice"/>
                            <field name="price_unit"/>
                            <field name="market_unit_price_untaxed"/>
                            <field name="market_amount_untaxed"/>
                            <field name="market_unit_price_taxed"/>
                            <field name="market_amount_taxed"/>
                            <field name="qty_available"/>
                            <field name="virtual_available"/>
                        </tree>
                    </field>
                    <label for="notes"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="market_action" model="ir.actions.act_window">
        <field name="name">Market</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">market.market</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="market_menu_root" name="Markets" sequence="80" web_icon="market,static/description/icon.png" groups="market_group_user"/>
    <menuitem id="main_market_menu" name="Market" sequence="1" parent="market_menu_root"/>
    <menuitem id="market_menu" name="Market" sequence="1" action="market_action" parent="main_market_menu"/>
</odoo>