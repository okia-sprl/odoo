<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="category_market" model="ir.module.category">
        <field name="name">Market</field>
        <field name="sequence">50</field>
    </record>

    <record id="market_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="category_market"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="market_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="implied_ids" eval="[(4, ref('market_group_user'))]"/>
        <field name="category_id" ref="category_market"/>
    </record>

    <record id="market_comp_rule" model="ir.rule">
        <field name="name">Market multi-company</field>
        <field name="model_id" ref="model_market_market"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>
    </record>

    <record id="market_line_comp_rule" model="ir.rule">
        <field name="name">Market Line multi-company</field>
        <field name="model_id" ref="model_market_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>
    </record>
</odoo>