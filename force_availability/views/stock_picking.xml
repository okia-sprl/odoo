<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_form_inherit" model="ir.ui.view">
        <field name="name">view.picking.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_assign']" position="after">
                <button name="force_availability" type="object" attrs="{'invisible': [('show_check_availability', '=', False)]}" string="Force Availability" grous="stock.group_stock_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
