<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pricing_setting_container']" position="inside">
                <setting id="average_cost" help="The Average Cost is computed as the average of product purchase over specific period multiply by a coefficient" company_dependent="1">
                    <field name="average_cost_coefficient"/>
                    <field name="average_cost_range"/>
                    <field name="average_cost_range_type"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
