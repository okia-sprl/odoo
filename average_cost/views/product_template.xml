<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_view_tree_inherit" model="ir.ui.view">
        <field name="name">product.template.view.tree.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="average_cost" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_kanban_view_inherit" model="ir.ui.view">
        <field name="name">product.template.kanban.view.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//span[field[@name='list_price']]" position="inside">
                Average Cost: <field name="average_cost" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"></field>
            </xpath>
        </field>
    </record>

    <record id="product_template_view_form_inherit" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_standard_price']/div[@name='standard_price_uom']" position="after">
                <label for="average_cost"/>
                <div name="average_cost_container">
                    <field name="average_cost" class="oe_inline" widget='monetary'
                           options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                    <button name="apply_average_cost" icon="fa-arrow-right" type="object"
                            groups="product.group_product_pricelist" class="oe_inline" invisible="average_cost == 'list_price'">
                        <span>
                            Apply Average Cost
                        </span>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_inherit" model="ir.ui.view">
        <field name="name">product.template.search.view.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='activities_exception']" position="after">
                <filter string="Prices to update" name="price_update_required" domain="[('is_price_update_required', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
