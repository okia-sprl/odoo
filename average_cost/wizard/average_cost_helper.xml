<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="average_cost_helper_view_form" model="ir.ui.view">
        <field name="name">average.cost.helper.view.form</field>
        <field name="model">average.cost.helper</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="product_category_id"/>
                    <field name="is_remove_product_without_average_cost"/>
                </group>
                <p>Current coefficient: <strong><field name="current_coefficient" nolabel="1"/></strong></p>
                <field name="line_ids">
                    <list editable="bottom" create="1" multi_edit="1" string="Update Prices">
                        <field name="product_tmpl_id"/>
                        <field name="current_price"/>
                        <field name="new_price" required="1"/>
                        <field name="currency_id" invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button string="Confirm" name="action_update_price" type="object" class="btn-primary" confirm="Did you check to see if there were multiple product pages?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_average_cost_helper" model="ir.actions.act_window">
        <field name="name">Update of product prices</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">average.cost.helper</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="average_cost_helper_view_form"/>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_average_cost_helper" name="Update of product prices" parent="sale.product_menu_catalog" action="action_average_cost_helper" groups="product.group_product_pricelist" sequence="4"/>
</odoo>
